include_guard(DIRECTORY)

function(__internalFetchVersion)
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../version.json" JSON_STR)
    string(JSON VERSION_TYPE TYPE "${JSON_STR}")
    string(JSON VERSION_LENGTH LENGTH "${JSON_STR}")
    if(NOT VERSION_TYPE STREQUAL "OBJECT" OR NOT VERSION_LENGTH EQUAL 4)
        message(FATAL_ERROR "version.json must contain exactly major, minor, patch, suffix")
    endif()
    foreach(KEY major minor patch suffix)
        string(JSON VALUE_TYPE TYPE "${JSON_STR}" "${KEY}")
        if(NOT VALUE_TYPE STREQUAL "STRING")
            message(FATAL_ERROR "version.json values must be strings")
        endif()
    endforeach()

    string(JSON MAJOR  GET "${JSON_STR}" "major")
    string(JSON MINOR  GET "${JSON_STR}" "minor")
    string(JSON PATCH  GET "${JSON_STR}" "patch")
    string(JSON SUFFIX GET "${JSON_STR}" "suffix")
    foreach(VALUE "${MAJOR}" "${MINOR}" "${PATCH}")
        if(NOT VALUE MATCHES "^(0|[1-9][0-9]*)$")
            message(FATAL_ERROR "version components must be canonical nonnegative integers")
        endif()
    endforeach()
    if(NOT MAJOR MATCHES "^[012]$")
        message(FATAL_ERROR "MAJOR must not exceed 2")
    endif()

    set(IDENTIFIERS "[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*")
    if(NOT SUFFIX STREQUAL "")
        if(NOT SUFFIX MATCHES "^(${IDENTIFIERS})?(\\+${IDENTIFIERS})?$")
            message(FATAL_ERROR "invalid SemVer suffix")
        endif()
        string(REGEX REPLACE "\\+.*$" "" PRERELEASE "${SUFFIX}")
        string(REPLACE "." ";" PRERELEASE_IDS "${PRERELEASE}")
        foreach(ID IN LISTS PRERELEASE_IDS)
            if(ID MATCHES "^0[0-9]+$")
                message(FATAL_ERROR "numeric prerelease identifiers must not have leading zeros")
            endif()
        endforeach()
    endif()

    if(SUFFIX STREQUAL "")
        set(SUFFIX_SHORT "")
    else()
        string(SUBSTRING "${SUFFIX}" 0 1 SUFFIX_SHORT)
    endif()

    set(MAJOR  "${MAJOR}"  PARENT_SCOPE)
    set(MINOR  "${MINOR}"  PARENT_SCOPE)
    set(PATCH  "${PATCH}"  PARENT_SCOPE)
    set(SUFFIX "${SUFFIX}" PARENT_SCOPE)

    set(SUFFIX_SHORT "${SUFFIX_SHORT}" PARENT_SCOPE)
endfunction()

function(FetchCMakeFriendlyVersion)
    __internalFetchVersion()

    set(CMAKE_FRIENDLY_VERSION "${MAJOR}.${MINOR}.${PATCH}")
    message(STATUS "CMake friendly version: ${CMAKE_FRIENDLY_VERSION}")

    set(RESULT_VAR "${CMAKE_FRIENDLY_VERSION}" PARENT_SCOPE)
endfunction()

function(FetchVersion)
    __internalFetchVersion()

    if(SUFFIX STREQUAL "")
        set(VERSION "${MAJOR}.${MINOR}.${PATCH}")
    elseif(SUFFIX MATCHES "^\\+")
        set(VERSION "${MAJOR}.${MINOR}.${PATCH}${SUFFIX}")
    else()
        set(VERSION "${MAJOR}.${MINOR}.${PATCH}-${SUFFIX}")
    endif()
    message(STATUS "Version: ${VERSION}")

    set(RESULT_VAR "${VERSION}" PARENT_SCOPE)
endfunction()
